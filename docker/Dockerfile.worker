# SocialReelSaver.Worker
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY SocialReelSaver.sln ./
COPY src/SocialReelSaver.Shared/SocialReelSaver.Shared.csproj src/SocialReelSaver.Shared/
COPY src/SocialReelSaver.Domain/SocialReelSaver.Domain.csproj src/SocialReelSaver.Domain/
COPY src/SocialReelSaver.Application/SocialReelSaver.Application.csproj src/SocialReelSaver.Application/
COPY src/SocialReelSaver.Infrastructure/SocialReelSaver.Infrastructure.csproj src/SocialReelSaver.Infrastructure/
COPY src/SocialReelSaver.Worker/SocialReelSaver.Worker.csproj src/SocialReelSaver.Worker/

RUN dotnet restore src/SocialReelSaver.Worker/SocialReelSaver.Worker.csproj

COPY src/ ./src/
RUN dotnet publish src/SocialReelSaver.Worker/SocialReelSaver.Worker.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:9.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "SocialReelSaver.Worker.dll"]
