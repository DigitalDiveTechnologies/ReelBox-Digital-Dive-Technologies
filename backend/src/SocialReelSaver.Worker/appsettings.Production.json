{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "",
    "Redis": "localhost:6379"
  },
  "Database": {
    "ConnectionString": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Storage": {
    "LocalDirectory": "C:\\ReelBox\\storage"
  },
  "ObjectStorage": {
    "Provider": "Local",
    "BucketName": "social-reel-saver",
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "auto",
    "LocalRootPath": "C:\\ReelBox\\storage",
    "UploadTimeoutSeconds": 120,
    "PublicApiBaseUrl": "http://157.254.225.131:8080",
    "PlaybackUrlExpirationMinutes": 15,
    "PlaybackSigningKey": ""
  },
  "Providers": {
    "TimeoutSeconds": 180,
    "MaximumExecutionSeconds": 180,
    "Resolver": "YtDlp",
    "AccessToken": "",
    "YtDlpExecutablePath": "yt-dlp",
    "YtDlpTimeoutSeconds": 330,
    "Instagram": {
      "Enabled": true,
      "RetryEligible": true
    },
    "Facebook": {
      "Enabled": true,
      "RetryEligible": true
    }
  },
  "Worker": {
    "QueueName": "media-download-jobs",
    "PollIntervalMilliseconds": 1000,
    "DequeueTimeoutMilliseconds": 2000,
    "MaxRetries": 3,
    "BaseBackoffSeconds": 2,
    "MaxBackoffSeconds": 60,
    "UseInMemoryQueue": false,
    "StuckJobTimeoutMinutes": 15
  }
}
