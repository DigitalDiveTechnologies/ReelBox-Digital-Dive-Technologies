{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=social_reel_saver;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=social_reel_saver;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "ObjectStorage": {
    "Provider": "Local",
    "BucketName": "social-reel-saver",
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "auto",
    "LocalRootPath": "storage",
    "UploadTimeoutSeconds": 120,
    "PublicApiBaseUrl": "http://localhost:5080",
    "PlaybackUrlExpirationMinutes": 15,
    "PlaybackSigningKey": ""
  },
  "Download": {
    "TimeoutSeconds": 120,
    "MaxFileSizeBytes": 262144000,
    "TempFolder": "temp/downloads",
    "AllowedMimeTypes": [
      "video/mp4",
      "video/quicktime",
      "video/webm",
      "image/jpeg",
      "image/png",
      "image/webp",
      "application/octet-stream"
    ]
  },
  "Providers": {
    "TimeoutSeconds": 30,
    "MaximumExecutionSeconds": 60,
    "GraphApiBaseUrl": "https://graph.facebook.com/v21.0",
    "AccessToken": "",
    "AllowedResolvedHostSuffixes": [
      ".cdninstagram.com",
      ".fbcdn.net",
      "scontent.cdninstagram.com",
      "scontent.xx.fbcdn.net",
      "video.xx.fbcdn.net",
      "video.cdninstagram.com"
    ],
    "Instagram": {
      "Enabled": true,
      "RetryEligible": true
    },
    "Facebook": {
      "Enabled": true,
      "RetryEligible": true
    }
  },
  "Worker": {
    "QueueName": "media-download-jobs",
    "PollIntervalMilliseconds": 1000,
    "DequeueTimeoutMilliseconds": 2000,
    "MaxRetries": 3,
    "BaseBackoffSeconds": 2,
    "MaxBackoffSeconds": 60,
    "UseInMemoryQueue": false
  }
}
