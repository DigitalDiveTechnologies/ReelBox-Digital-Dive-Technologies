{
  "_comment": "Copy to appsettings.Production.local.json next to the published DLL. API + Worker must share Redis + Neon + storage.",
  "ConnectionStrings": {
    "PostgreSQL": "Host=YOUR_NEON_HOST;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;Port=5432;SSL Mode=Require;Trust Server Certificate=true",
    "Redis": "localhost:6379"
  },
  "Database": {
    "ConnectionString": "Host=YOUR_NEON_HOST;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;Port=5432;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Storage": {
    "LocalDirectory": "C:\\ReelBox\\storage"
  },
  "ObjectStorage": {
    "Provider": "Local",
    "LocalRootPath": "C:\\ReelBox\\storage",
    "PublicApiBaseUrl": "http://157.254.225.131:8080",
    "PlaybackSigningKey": "REPLACE_WITH_LONG_RANDOM_PLAYBACK_SIGNING_KEY"
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_LONG_RANDOM_MOBILE_JWT_SIGNING_KEY"
  },
  "AdminJwt": {
    "SigningKey": "REPLACE_WITH_LONG_RANDOM_ADMIN_JWT_SIGNING_KEY"
  },
  "AdminBootstrap": {
    "Email": "support.reelbox@digitaldive.net",
    "Password": "REPLACE_ADMIN_PASSWORD",
    "DisplayName": "Super Admin"
  },
  "Smtp": {
    "Host": "chocobo.mxrouting.net",
    "Port": 587,
    "Username": "support.reelbox@digitaldive.net",
    "Password": "YOUR_SMTP_PASSWORD",
    "EnableSsl": true,
    "FromEmail": "support.reelbox@digitaldive.net",
    "FromName": "ReelBox Support",
    "ResetNotifyEmail": "support.reelbox@digitaldive.net"
  },
  "Providers": {
    "Resolver": "YtDlp",
    "YtDlpExecutablePath": "yt-dlp"
  },
  "Worker": {
    "UseInMemoryQueue": false,
    "RunInApiHost": false,
    "QueueName": "media-download-jobs",
    "StuckJobTimeoutMinutes": 15
  }
}
