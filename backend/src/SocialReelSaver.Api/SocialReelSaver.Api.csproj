<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SocialReelSaver.Api</RootNamespace>
    <AssemblyName>SocialReelSaver.Api</AssemblyName>
    <UserSecretsId>social-reel-saver-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialReelSaver.Application\SocialReelSaver.Application.csproj" />
    <ProjectReference Include="..\SocialReelSaver.Infrastructure\SocialReelSaver.Infrastructure.csproj" />
    <ProjectReference Include="..\SocialReelSaver.Shared\SocialReelSaver.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure empty logs folder exists on publish for ANCM stdout -->
    <Content Include="logs\.gitkeep" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

</Project>
