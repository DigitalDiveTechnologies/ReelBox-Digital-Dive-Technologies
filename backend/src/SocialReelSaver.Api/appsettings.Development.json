{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=social_reel_saver;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=social_reel_saver;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "SocialReelSaver",
    "Audience": "SocialReelSaver.Mobile",
    "SigningKey": "DEV_ONLY_REPLACE_WITH_LONG_RANDOM_SECRET_KEY_64CHARS_MINIMUM_VALUE",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "ObjectStorage": {
    "Provider": "Local",
    "LocalRootPath": "storage-dev",
    "PublicApiBaseUrl": "http://192.168.100.8:5080"
  },
  "Download": {
    "TempFolder": "temp/downloads-dev"
  },
  "Worker": {
    "UseInMemoryQueue": true
  }
}
