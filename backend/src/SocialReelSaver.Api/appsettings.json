{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AdminOrigins": []
  },
  "ConnectionStrings": {
    "PostgreSQL": "",
    "Redis": "localhost:6379"
  },
  "Database": {
    "ConnectionString": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "ObjectStorage": {
    "Provider": "Local",
    "BucketName": "social-reel-saver",
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "auto",
    "LocalRootPath": "C:\\ReelBox\\storage",
    "UploadTimeoutSeconds": 120,
    "PublicApiBaseUrl": "http://157.254.225.131:8080",
    "PlaybackUrlExpirationMinutes": 15,
    "PlaybackSigningKey": ""
  },
  "Storage": {
    "LocalDirectory": "C:\\ReelBox\\storage"
  },
  "Download": {
    "TimeoutSeconds": 120,
    "MaxFileSizeBytes": 262144000,
    "TempFolder": "temp/downloads",
    "AllowedMimeTypes": [
      "video/mp4",
      "video/quicktime",
      "video/webm",
      "image/jpeg",
      "image/png",
      "image/webp",
      "application/octet-stream"
    ]
  },
  "Providers": {
    "TimeoutSeconds": 180,
    "MaximumExecutionSeconds": 180,
    "Resolver": "YtDlp",
    "YtDlpExecutablePath": "yt-dlp",
    "YtDlpTimeoutSeconds": 150,
    "GraphApiBaseUrl": "https://graph.facebook.com/v21.0",
    "AccessToken": "",
    "AllowedResolvedHostSuffixes": [
      ".cdninstagram.com",
      ".fbcdn.net",
      "scontent.cdninstagram.com",
      "scontent.xx.fbcdn.net",
      "video.xx.fbcdn.net",
      "video.cdninstagram.com"
    ],
    "Instagram": {
      "Enabled": true,
      "RetryEligible": true
    },
    "Facebook": {
      "Enabled": true,
      "RetryEligible": true
    }
  },
  "Jwt": {
    "Issuer": "SocialReelSaver",
    "Audience": "SocialReelSaver.Mobile",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 129600,
    "RefreshTokenExpirationDays": 90
  },
  "AdminJwt": {
    "Issuer": "SocialReelSaver",
    "Audience": "SocialReelSaver.Admin",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "AdminBootstrap": {
    "Email": "",
    "Password": "",
    "DisplayName": "Super Admin"
  },
  "Smtp": {
    "Host": "chocobo.mxrouting.net",
    "Port": 587,
    "Username": "support.reelbox@digitaldive.net",
    "Password": "",
    "EnableSsl": true,
    "FromEmail": "support.reelbox@digitaldive.net",
    "FromName": "ReelBox Support",
    "ResetNotifyEmail": "support.reelbox@digitaldive.net"
  },
  "Worker": {
    "QueueName": "media-download-jobs",
    "PollIntervalMilliseconds": 1000,
    "DequeueTimeoutMilliseconds": 2000,
    "MaxRetries": 3,
    "BaseBackoffSeconds": 2,
    "MaxBackoffSeconds": 60,
    "UseInMemoryQueue": false,
    "RunInApiHost": false,
    "StuckJobTimeoutMinutes": 15
  }
}
