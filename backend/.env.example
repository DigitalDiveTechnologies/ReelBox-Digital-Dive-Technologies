# Social Reel Saver — backend environment template
# Copy into shell / SmarterASP Application Settings / CI secrets.
# ASP.NET Core maps nested config with double underscores (__).
# NEVER commit real production values.

ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production

# PostgreSQL (Neon)
ConnectionStrings__PostgreSQL=Host=YOUR_NEON_HOST;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;Port=5432;Ssl Mode=Require;Trust Server Certificate=true
Database__ConnectionString=Host=YOUR_NEON_HOST;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;Port=5432;Ssl Mode=Require;Trust Server Certificate=true

# Redis (required on VPS Production — API publishes, Worker consumes)
# Set Worker__UseInMemoryQueue=false and point both hosts at the same Redis.
ConnectionStrings__Redis=localhost:6379
Redis__ConnectionString=localhost:6379

# Object storage (API + Worker must share the same root on co-hosted VPS)
Storage__LocalDirectory=C:\ReelBox\storage
ObjectStorage__Provider=Local
ObjectStorage__BucketName=social-reel-saver
ObjectStorage__ServiceUrl=
ObjectStorage__AccessKey=
ObjectStorage__SecretKey=
ObjectStorage__Region=auto
ObjectStorage__LocalRootPath=C:\ReelBox\storage
ObjectStorage__PublicApiBaseUrl=http://157.254.225.131:8080
ObjectStorage__PlaybackUrlExpirationMinutes=15
ObjectStorage__PlaybackSigningKey=

# Mobile JWT
Jwt__Issuer=SocialReelSaver
Jwt__Audience=SocialReelSaver.Mobile
Jwt__SigningKey=REPLACE_WITH_LONG_RANDOM_MOBILE_JWT_SIGNING_KEY
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Admin JWT (must differ from mobile signing key)
AdminJwt__Issuer=SocialReelSaver
AdminJwt__Audience=SocialReelSaver.Admin
AdminJwt__SigningKey=REPLACE_WITH_LONG_RANDOM_ADMIN_JWT_SIGNING_KEY
AdminJwt__AccessTokenExpirationMinutes=15
AdminJwt__RefreshTokenExpirationDays=7

# Optional first SuperAdmin seed (only when admin_users is empty)
AdminBootstrap__Email=
AdminBootstrap__Password=
AdminBootstrap__DisplayName=Super Admin

# Providers (Worker uses YtDlp)
Providers__Resolver=YtDlp
Providers__AccessToken=
Providers__GraphApiBaseUrl=https://graph.facebook.com/v21.0
Providers__YtDlpExecutablePath=yt-dlp

# Admin SPA CORS (Cloudflare Pages HTTPS origin)
Cors__AdminOrigins__0=https://YOUR-ADMIN-PAGES-HOST

# Worker / queue (API + Worker share Redis on VPS)
# Production API must NOT consume jobs — dedicated SocialReelSaver.Worker only.
Worker__QueueName=media-download-jobs
Worker__UseInMemoryQueue=false
Worker__RunInApiHost=false
Worker__MaxRetries=3
Worker__StuckJobTimeoutMinutes=15

# SMTP (MXRoute) — Admin forgot-password emails
Smtp__Host=chocobo.mxrouting.net
Smtp__Port=587
Smtp__Username=support.reelbox@digitaldive.net
Smtp__Password=YOUR_SMTP_PASSWORD
Smtp__EnableSsl=true
Smtp__FromEmail=support.reelbox@digitaldive.net
Smtp__FromName=ReelBox Support
Smtp__ResetNotifyEmail=support.reelbox@digitaldive.net
