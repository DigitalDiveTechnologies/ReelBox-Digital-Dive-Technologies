# Social Reel Saver — backend environment template
# Copy values into your shell, IDE launch profile, or docker-compose overrides.
# ASP.NET Core maps nested config with double underscores (__).

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# PostgreSQL (SRS §18)
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=social_reel_saver;Username=postgres;Password=postgres
Database__ConnectionString=Host=localhost;Port=5432;Database=social_reel_saver;Username=postgres;Password=postgres

# Redis queue (SRS §18 MVP)
ConnectionStrings__Redis=localhost:6379
Redis__ConnectionString=localhost:6379

# Object storage (local for development; R2/S3 in production)
ObjectStorage__Provider=Local
ObjectStorage__BucketName=social-reel-saver
ObjectStorage__ServiceUrl=
ObjectStorage__AccessKey=
ObjectStorage__SecretKey=
ObjectStorage__Region=auto
ObjectStorage__LocalRootPath=storage
ObjectStorage__PublicApiBaseUrl=http://localhost:5080
ObjectStorage__PlaybackUrlExpirationMinutes=15
ObjectStorage__PlaybackSigningKey=

# JWT (replace SigningKey before any non-local use)
Jwt__Issuer=SocialReelSaver
Jwt__Audience=SocialReelSaver.Mobile
Jwt__SigningKey=DEV_ONLY_REPLACE_WITH_LONG_RANDOM_SECRET_KEY_64CHARS_MINIMUM_VALUE
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Provider credentials (server-side only; never ship in the mobile app)
Providers__AccessToken=
Providers__GraphApiBaseUrl=https://graph.facebook.com/v21.0

# FFmpeg thumbnail extraction (SRS FR-010). Leave on PATH or set absolute path.
Ffmpeg__ExecutablePath=ffmpeg
Ffmpeg__TimeoutSeconds=30
Ffmpeg__SeekPosition=00:00:01

# Worker / queue
Worker__QueueName=media-download-jobs
Worker__UseInMemoryQueue=true
Worker__MaxRetries=3
